# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Map Configuration
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_access_token

# Razorpay Configuration (Public Key)
NEXT_PUBLIC_RAZORPAY_KEY=your_razorpay_key_id

# Analytics (optional)
NEXT_PUBLIC_GA_ID=

# Business Name
NEXT_PUBLIC_BUSINESS_NAME=LocalEats
NEXT_PUBLIC_CITY_NAME=Kahalgaon

# Feature Flags
NEXT_PUBLIC_ENABLE_LIVE_TRACKING=true
NEXT_PUBLIC_ENABLE_RATING=true
